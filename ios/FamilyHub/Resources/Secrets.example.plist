<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy this file to Secrets.plist (same folder) and fill in your Supabase project values.
  Secrets.plist is git-ignored. If it is missing, the app runs in Demo mode with sample data.
-->
<plist version="1.0">
<dict>
	<key>SupabaseURL</key>
	<string>https://YOUR-PROJECT-REF.supabase.co</string>
	<key>SupabaseAnonKey</key>
	<string>YOUR-ANON-OR-PUBLISHABLE-KEY</string>
</dict>
</plist>
